{
  "kit_id": "bio-01_clinical_exercise_glycemic",
  "title": "Clinical Exercise Program for Glycemic Control Feasibility",
  "decision": "Judge whether a clinic- or insurer-embedded structured exercise program is viable once its headline mean HbA1c reduction is decomposed.",
  "source": "NHANES 2017-2018 Continuous",
  "license": "U.S. Government work / public domain",
  "tables": [
    {
      "name": "fact_participant_glycemic",
      "description": "One row per participant with demographics, HbA1c, BMI, physical activity indicators, diabetes status, and survey weights. Grain: SEQN.",
      "columns": [
        {"name": "SEQN", "type": "float", "description": "Respondent sequence number (unique ID)", "example": 93703.0, "is_key": true},
        {"name": "age_years", "type": "float", "description": "Age in years at screening", "example": 2.0, "source": "DEMO_J.RIDAGEYR"},
        {"name": "sex", "type": "float", "description": "Gender (1=Male, 2=Female)", "example": 2.0, "source": "DEMO_J.RIAGENDR"},
        {"name": "hba1c", "type": "float", "description": "Glycohemoglobin (%)", "example": 5.5, "source": "GHB_J.LBXGH", "notes": "Missing for non-MEC or non-lab"},
        {"name": "bmi", "type": "float", "description": "Body Mass Index (kg/m2)", "example": 25.8, "source": "BMX_J.BMXBMI"},
        {"name": "mec_weight", "type": "float", "description": "Full sample 2-year MEC exam weight", "example": 21059.89, "source": "DEMO_J.WTMEC2YR", "notes": "Use for nationally representative estimates"},
        {"name": "diabetes_status", "type": "float", "description": "Doctor told you have diabetes (1=Yes, 2=No, 3=Borderline, 7/9=Refused/Don't know)", "example": 2.0, "source": "DIQ_J.DIQ010"}
      ]
    },
    {
      "name": "dim_cycle",
      "description": "Survey cycle dimension",
      "columns": [
        {"name": "cycle_id", "type": "string", "example": "J"},
        {"name": "years", "type": "string", "example": "2017-2018"}
      ]
    },
    {
      "name": "dim_variable",
      "description": "Assay/questionnaire variable metadata",
      "columns": [
        {"name": "var_id", "type": "string", "example": "hba1c"},
        {"name": "description", "type": "string", "example": "Glycohemoglobin (%)"},
        {"name": "unit", "type": "string", "example": "%"},
        {"name": "source_file", "type": "string", "example": "GHB_J"},
        {"name": "original_name", "type": "string", "example": "LBXGH"}
      ]
    }
  ],
  "transforms": [
    "Downloaded XPT from CDC Public/2017/DataFiles/",
    "Read with pyreadstat.read_xport",
    "Left-merged on SEQN from DEMO",
    "Renamed key columns for clarity",
    "Preserved survey weights for proper inference"
  ],
  "join_keys": ["SEQN"],
  "notes": "For viability analysis: stratify mean hba1c by activity levels (PAQ vars), age, BMI, diabetes status; compare weighted vs unweighted; check baseline imbalance. Trap: non-random 'assignment' via self-reported activity; Simpson by age/BMI."
}